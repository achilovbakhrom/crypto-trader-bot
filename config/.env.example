# Chain RPC (Base Sepolia for dev, Base mainnet for prod)
CHAIN_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
CHAIN_WS_URL=wss://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# Binance API
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Wallet (for signing liquidation transactions on-chain)
PRIVATE_KEY=0xyour_private_key_here

# Database
DATABASE_URL=postgres://user:password@localhost:5432/crypto_trader

# OpenObserve
OPENOBSERVE_URL=http://localhost:5080
OPENOBSERVE_TOKEN=your_openobserve_token

# App
APP_ENV=development
SQLX_OFFLINE=true
